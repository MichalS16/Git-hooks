# Python virtual environment (used to install flake8/pytest/coverage
# for hooks/pre-commit; see README "Testing the hooks").
.venv/

# Python bytecode cache.
__pycache__/
*.pyc

# Coverage data from `coverage run` (hooks/pre-commit normally removes
# this itself after a successful run, but it can be left behind if the
# hook is interrupted or fails partway through).
.coverage
