#!/bin/bash
# A Git pre-commit hook example.
# This is a live working script, implemented in the repo.
#
# set -u:  fail fast on unset variables (typos in $VARS) instead of
#          silently treating them as empty strings.
# set -o pipefail: a failure in the left side of a pipe (e.g. `foo | bar`)
#          fails the whole pipeline instead of being masked by `bar`'s exit
#          code. We do NOT use `set -e`: exit codes from flake8/pytest/
#          coverage are checked explicitly below to print a clear message
#          before aborting, which `set -e` would short-circuit.
set -uo pipefail
#
# NOTE: hook installation is an explicit, one-time step, not something this
# hook performs on its own. Run "bash hooks-accessories/install-hooks.sh"
# yourself after cloning or after changing anything under hooks/.
# A hook that reinstalls itself on every commit would let any change merged
# into hooks/ become auto-executing, privileged code on a contributor's very
# next commit, without review. See README "Security Considerations" for
# details on why this differs from our original submission.
#
# --- Original self-installing variant (kept here for reference only) ---
# echo "Running install-hooks.sh to update hooks and adjust their line endings..."
# bash hooks-accessories/install-hooks.sh
# INSTALL_HOOKS_EXIT_CODE=$?
# if [ $INSTALL_HOOKS_EXIT_CODE -ne 0 ]; then
#   echo "Failed to run install-hooks.sh. Please check the script and try again."
#   echo "Aborting the commit."
#   exit 1
# fi
# -------------------------------------------------------------------------


#######################
####### Messages ######
#######################

# shellcheck source=hooks/lib/banner.sh
source "$(dirname "$0")/lib/banner.sh"

hook_start "PRE-COMMIT"
echo "Your commit is about to happen. Running the pre-commit hooks..."


#######################
####### Logging #######
#######################

# Logged and staged here (before the commit exists) instead of amending the
# commit afterwards in post-commit. This avoids rewriting commit history for
# every commit, which is the industry-standard way to attach metadata: add
# it to the commit as it is created, not amend it after the fact.
echo "Logging commit details..."

FILE_LOG="hooks-accessories/commit-log.txt"

COMMIT_AUTHOR=$(git config user.name)
COMMIT_DATE=$(date)

echo "------------------------------------------------" >> "$FILE_LOG"
echo "Author: $COMMIT_AUTHOR" >> "$FILE_LOG"
echo "Date: $COMMIT_DATE" >> "$FILE_LOG"
echo "" >> "$FILE_LOG"

git add "$FILE_LOG"
echo "Done appending commit details to $FILE_LOG."


#######################
##### Code checks #####
#######################

# Fail with a clear message instead of a cryptic "command not found" if a
# required tool isn't installed in the current environment/venv.
for TOOL in flake8 pytest coverage; do
  if ! command -v "$TOOL" >/dev/null 2>&1; then
    echo "Error: '$TOOL' is not installed or not on PATH."
    echo "Install it (e.g. 'pip install $TOOL') before committing, or activate your virtualenv."
    echo "Aborting the commit."
    exit 1
  fi
done

# Flake8, style guide enforcement
echo "Running Flake8, a detector of code style issues and programming errors..."
flake8 . --exclude=.venv # current directory, excluding the python .venv folder
if [ $? -ne 0 ]; then
  echo "Code issues detected according to Flake8. Please fix them before committing."
  echo "Aborting the commit."
  exit 1 # stop the commit
fi

# Pytest, unit tests - run once, under coverage, so the suite isn't
# executed twice on every commit. `coverage run -m pytest` passes through
# pytest's own exit codes unchanged (0 success, 5 no tests collected).
echo "Running Pytest (with coverage), unit tests in the repo..."
coverage run -m pytest # the --no-data-file is somehow buggy for us, so omitted, and removing the report manually later
PYTEST_EXIT_CODE=$?

if [ $PYTEST_EXIT_CODE -eq 0 ]; then
  echo "Pytest completed successfully."
elif [ $PYTEST_EXIT_CODE -eq 5 ]; then
  echo "No Pytest test was found. Proceeding with the commit."
else
  echo "Pytest unit tests failed with exit code $PYTEST_EXIT_CODE. Please fix the issues before committing."
  echo "Aborting the commit."
  exit 1
fi

# Code coverage check
echo "Checking code coverage of Pytest..."
coverage report
COVERAGE_EXIT_CODE=$?

if [ $COVERAGE_EXIT_CODE -eq 0 ]; then
  echo "Coverage check completed successfully."
elif [ $COVERAGE_EXIT_CODE -eq 5 ]; then
  echo "No data was collected. Proceeding with the commit."
else
  echo "Coverage check failed with exit code $COVERAGE_EXIT_CODE. Please ensure sufficient coverage before committing."
  echo "Aborting the commit."
  exit 1
fi

# Clean up: Remove the .coverage file if it exists
if [ -f ".coverage" ]; then
  rm .coverage
  echo ".coverage file removed after coverage check."
fi


# Display the end message
hook_end "PRE-COMMIT"
