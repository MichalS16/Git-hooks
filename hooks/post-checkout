#!/bin/bash
# A Git post-checkout hook example.
# Runs after `git checkout` (branch switch) or `git clone`.
# Git calls this with: <previous HEAD> <new HEAD> <flag: 1 if a branch checkout, 0 if a file checkout>

set -uo pipefail

# shellcheck source=hooks/lib/banner.sh
source "$(dirname "$0")/lib/banner.sh"

PREV_HEAD="$1"
NEW_HEAD="$2"
IS_BRANCH_CHECKOUT="$3"

# File checkouts (e.g. `git checkout -- somefile.txt`) aren't branch
# switches, so there's nothing relevant for us to report here.
if [ "$IS_BRANCH_CHECKOUT" -ne 1 ]; then
  exit 0
fi

hook_start "POST-CHECKOUT"
echo "Switched branches: $(git rev-parse --abbrev-ref HEAD)"

# A common real-world use of this hook: remind the developer to reinstall
# hooks/dependencies if they just checked out a branch where those changed.
if ! git diff --quiet "$PREV_HEAD" "$NEW_HEAD" -- hooks/ 2>/dev/null; then
  echo "Note: hooks/ changed on this branch. Run 'bash hooks-accessories/install-hooks.sh' to update your installed hooks."
fi

hook_end "POST-CHECKOUT"
